# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
out/
*.tsbuildinfo

# env files (keep example files)
.env
.env.*
!.env.example

# secrets
*.pem
*.key
*.p12

# logs / coverage / caches
*.log
logs/
coverage/
.cache/
.turbo/
.eslintcache

# Envio generated code (recreated by `pnpm codegen`)
apps/indexer/.envio/types.d.ts
apps/indexer/generated/
apps/indexer/build/

# Foundry (dependencies are restored by `forge soldeer install` from contracts/soldeer.lock)
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
contracts/broadcast/*/*/dry-run/
contracts/dependencies/

# editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# AI agent tooling (local only; reinstall skills from skills-lock.json)
/.agents/
/.claude/
apps/indexer/.claude/

# code-graph tool cache (graphs live in the workspace vault)
graphify-out/

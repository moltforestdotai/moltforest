# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_PASSWORD=moltforest

# --- Indexer (Envio, runs in Docker) ---
# Required for fast history sync via HyperSync. Create one at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=
# config.yaml = mainnet + testnet via HyperSync (needs ENVIO_API_TOKEN)
# config.smoke.yaml = testnet only via public RPC from the latest block (no token needed)
ENVIO_CONFIG=config.yaml

# --- API and workers (run natively on the host) ---
DATABASE_URL=postgres://postgres:moltforest@localhost:5433/moltforest
INDEXER_DB_SCHEMA=envio
APP_DB_SCHEMA=app
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
MONAD_RPC_URL_MAINNET=https://rpc.monad.xyz
MONAD_RPC_URL_TESTNET=https://testnet-rpc.monad.xyz

# --- Enrichment worker (fetches remote registration files; defaults shown) ---
# ENRICH_BATCH_SIZE=500
# ENRICH_CONCURRENCY=24
# ENRICH_PER_HOST_CONCURRENCY=4
# ENRICH_PER_HOST_RPS=5
# ENRICH_TIMEOUT_MS=10000
# ENRICH_MAX_BYTES=262144
# IPFS_GATEWAYS=https://ipfs.io/ipfs/,https://w3s.link/ipfs/,https://gateway.pinata.cloud/ipfs/

# --- Liveness worker (probes declared service endpoints; defaults shown) ---
# LIVENESS_ENABLED=true
# LIVENESS_PER_HOST_RPS=1
# LIVENESS_TIMEOUT_MS=5000

# --- Live activity stream (API) ---
# ACTIVITY_POLL_MS=2000
# ACTIVITY_MAX_STREAMS=500

# --- Execution receipts (phase 4, decision D06; ReceiptRegistry on testnet only) ---
# The registry address ships in @moltforest/chain once deployed; overrides are for a local Anvil deployment.
# RECEIPT_REGISTRY_TESTNET=
# API: POST /v1/receipts limits (defaults shown)
# RECEIPT_SUBMIT_PER_MINUTE=30
# RECEIPT_MAX_FUTURE_SECONDS=300
# Footer newsletter signup limit per IP (defaults shown)
# NEWSLETTER_SUBMIT_PER_MINUTE=5
# Workers: the relayer anchors submitted receipts and pays the gas. Testnet-only key with a small
# balance (constraint C6); without it the relay is off and receipts stay queued.
# RELAYER_PRIVATE_KEY=
# RECEIPT_RELAY_ENABLED=true
# RECEIPT_RELAY_MAX_PER_AGENT_PER_DAY=100
# RECEIPT_RELAY_MIN_BALANCE_MON=0.05
# RECEIPT_RELAY_TX_TIMEOUT_SECONDS=60

# --- x402 payments worker (uses ENVIO_API_TOKEN above; defaults shown) ---
# PAYMENTS_ENABLED=true
# PAYMENTS_POLL_SECONDS=300
# --- Review assessment worker (decision D31; uses ENVIO_API_TOKEN; defaults shown) ---
# REVIEWS_ENABLED=true
# REVIEWS_POLL_SECONDS=300
# REVIEWS_HUB_MIN_AGENTS=10
# REVIEWS_REPEAT_WINDOW_DAYS=30
# --- Receipt event scan (receipts anchored on the ReceiptRegistry by anyone; uses ENVIO_API_TOKEN) ---
# RECEIPT_EVENTS_ENABLED=true
# RECEIPT_EVENTS_POLL_SECONDS=60
# --- Nansen related wallets of Monad mainnet reviewers (Nansen has no testnet data) ---
# Without a key the Nansen lookups are off. Each lookup costs 1 Nansen credit.
# NANSEN_API_KEY=
# NANSEN_ENABLED=true
# NANSEN_DAILY_LOOKUPS=25
# NANSEN_BATCH_SIZE=25
# NANSEN_POLL_SECONDS=600
# NANSEN_REQUEST_DELAY_MS=300
# NANSEN_TIMEOUT_MS=15000
# NANSEN_BASE_URL=https://api.nansen.ai
# Mainnet agent ids whose reviewers are looked up first (spend scarce credits on the agents a demo shows), e.g. 182,9
# NANSEN_FOCUS_AGENTS=

# --- Demo agents (apps/demo-agents, Monad testnet only; defaults shown) ---
# Testnet-only key of the email-verifier agent (constraint C6): it receives the x402 payments,
# pays registration gas, and signs receipts. Required to run the service.
# EMAIL_VERIFIER_PRIVATE_KEY=
# Set after `pnpm --filter @moltforest/demo-agents register --send`; receipts are off until then.
# EMAIL_VERIFIER_AGENT_ID=
# EMAIL_VERIFIER_PRICE_USDC=0.01
# EMAIL_VERIFIER_DNS_TIMEOUT_MS=3000
# DEMO_AGENTS_HOST=127.0.0.1
# DEMO_AGENTS_PORT=7051
# Public origin the agents are reached at (used in 402 responses and the registration file).
# DEMO_AGENTS_PUBLIC_URL=http://localhost:7051
# DEMO_AGENTS_RATE_LIMIT_PER_MINUTE=60
# X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
# MOLTFOREST_API_URL=https://api.moltforest.ai
# MOLTFOREST_WEB_URL=https://www.moltforest.ai

# --- Contract deployment (contracts/, run by the owner; never on the server) ---
# DEPLOYER_PRIVATE_KEY=
# DEPLOYER_ADDRESS=
# Floor 3 ScoreRegistry verifiers (addresses at deploy; private keys to cosign epochs):
# VERIFIER_1=
# VERIFIER_2=
# VERIFIER_3=
# VERIFIER_1_PRIVATE_KEY=
# VERIFIER_2_PRIVATE_KEY=
# VERIFIER_3_PRIVATE_KEY=
# SCORE_REGISTRY=   # optional override; defaults to packages/chain testnet.scoreRegistry
# EPOCH_ID=1   # optional for CLI; epoch pipeline auto-picks next id
# CRE_FORWARDER=    # optional; defaults to Monad testnet MockKeystoneForwarder for simulation
# For cre/epoch-publisher simulate --broadcast, also set CRE_ETH_PRIVATE_KEY in cre/.env
# SCORES_PENDING_API_KEY=  # when set, GET /v1/scores/pending-epoch requires Authorization: Bearer …

# --- Floor-3 epoch pipeline (apps/workers; enable on VPS for unattended testnet POC) ---
# Cosigns 2-of-3 with VERIFIER_*_PRIVATE_KEY, stages pending, then CRE simulate --broadcast.
# EPOCH_PIPELINE_ENABLED=true
# EPOCH_PIPELINE_NETWORKS=testnet
# EPOCH_PIPELINE_INTERVAL_SECONDS=3600
# EPOCH_PIPELINE_ALL_AGENTS=true
# EPOCH_PIPELINE_CRE_BROADCAST=true
# EPOCH_PIPELINE_CRE_DIR=cre
# EPOCH_PIPELINE_CRE_TARGET=local-simulation
# EPOCH_PIPELINE_FALLBACK_PUBLISH=true
# CRE_API_KEY=   # or run `cre login` once on the VPS; required even for simulate
# Install CRE CLI ≥ 1.30 on the VPS and put ~/.cre/bin on PATH for the workers process.

# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_PASSWORD=moltforest

# --- Indexer (Envio, runs in Docker) ---
# Required for fast history sync via HyperSync. Create one at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=
# config.yaml = mainnet + testnet via HyperSync (needs ENVIO_API_TOKEN)
# config.smoke.yaml = testnet only via public RPC from the latest block (no token needed)
ENVIO_CONFIG=config.yaml

# --- API and workers (run natively on the host) ---
DATABASE_URL=postgres://postgres:moltforest@localhost:5433/moltforest
INDEXER_DB_SCHEMA=envio
APP_DB_SCHEMA=app
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
MONAD_RPC_URL_MAINNET=https://rpc.monad.xyz
MONAD_RPC_URL_TESTNET=https://testnet-rpc.monad.xyz

# --- Enrichment worker (fetches remote registration files; defaults shown) ---
# ENRICH_BATCH_SIZE=500
# ENRICH_CONCURRENCY=24
# ENRICH_PER_HOST_CONCURRENCY=4
# ENRICH_PER_HOST_RPS=5
# ENRICH_TIMEOUT_MS=10000
# ENRICH_MAX_BYTES=262144
# IPFS_GATEWAYS=https://ipfs.io/ipfs/,https://w3s.link/ipfs/,https://gateway.pinata.cloud/ipfs/

# --- Liveness worker (probes declared service endpoints; defaults shown) ---
# LIVENESS_ENABLED=true
# LIVENESS_PER_HOST_RPS=1
# LIVENESS_TIMEOUT_MS=5000

# --- Live activity stream (API) ---
# ACTIVITY_POLL_MS=2000
# ACTIVITY_MAX_STREAMS=500

# --- Execution receipts (phase 4, decision D06; ReceiptRegistry on testnet only) ---
# The registry address ships in @moltforest/chain once deployed; overrides are for a local Anvil deployment.
# RECEIPT_REGISTRY_TESTNET=
# API: POST /v1/receipts limits (defaults shown)
# RECEIPT_SUBMIT_PER_MINUTE=30
# RECEIPT_MAX_FUTURE_SECONDS=300
# Workers: the relayer anchors submitted receipts and pays the gas. Testnet-only key with a small
# balance (constraint C6); without it the relay is off and receipts stay queued.
# RELAYER_PRIVATE_KEY=
# RECEIPT_RELAY_ENABLED=true
# RECEIPT_RELAY_MAX_PER_AGENT_PER_DAY=100
# RECEIPT_RELAY_MIN_BALANCE_MON=0.05
# RECEIPT_RELAY_TX_TIMEOUT_SECONDS=60

# --- x402 payments worker (uses ENVIO_API_TOKEN above; defaults shown) ---
# PAYMENTS_ENABLED=true
# PAYMENTS_POLL_SECONDS=300

# --- Contract deployment (contracts/, run by the owner; never on the server) ---
# DEPLOYER_PRIVATE_KEY=
# DEPLOYER_ADDRESS=

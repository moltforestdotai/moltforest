# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_PASSWORD=moltforest

# --- Indexer (Envio, runs in Docker) ---
# Required for fast history sync via HyperSync. Create one at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=
# config.yaml = mainnet + testnet via HyperSync (needs ENVIO_API_TOKEN)
# config.smoke.yaml = testnet only via public RPC from the latest block (no token needed)
ENVIO_CONFIG=config.yaml

# --- API and workers (run natively on the host) ---
DATABASE_URL=postgres://postgres:moltforest@localhost:5433/moltforest
INDEXER_DB_SCHEMA=envio
APP_DB_SCHEMA=app
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
MONAD_RPC_URL_MAINNET=https://rpc.monad.xyz
MONAD_RPC_URL_TESTNET=https://testnet-rpc.monad.xyz

# --- Enrichment worker (fetches remote registration files; defaults shown) ---
# ENRICH_BATCH_SIZE=500
# ENRICH_CONCURRENCY=24
# ENRICH_PER_HOST_CONCURRENCY=4
# ENRICH_PER_HOST_RPS=5
# ENRICH_TIMEOUT_MS=10000
# ENRICH_MAX_BYTES=262144
# IPFS_GATEWAYS=https://ipfs.io/ipfs/,https://w3s.link/ipfs/,https://gateway.pinata.cloud/ipfs/

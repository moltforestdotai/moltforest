{
  "name": "moltforest",
  "private": true,
  "license": "MIT",
  "description": "MoltForest backend: ERC-8004 indexer, trust API, and workers for the agent economy on Monad",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec postgres psql -U postgres -d moltforest",
    "indexer:up": "docker compose up -d --build indexer",
    "indexer:logs": "docker compose logs -f indexer",
    "indexer:stop": "docker compose stop indexer",
    "indexer:install": "docker compose run --rm indexer-tools pnpm install",
    "indexer:codegen": "docker compose run --rm indexer-tools pnpm codegen",
    "indexer:test": "docker compose run --rm indexer-tools pnpm test",
    "indexer:typecheck": "docker compose run --rm indexer-tools pnpm typecheck",
    "contracts:install": "docker compose run --rm foundry soldeer install",
    "contracts:build": "docker compose run --rm foundry build --sizes",
    "contracts:test": "docker compose run --rm foundry test -vv",
    "contracts:abi": "docker compose run --rm -T foundry inspect src/ReceiptRegistry.sol:ReceiptRegistry abi --json > apps/indexer/abis/ReceiptRegistry.json",
    "db:generate": "pnpm --filter @moltforest/db generate",
    "db:migrate": "pnpm --filter @moltforest/db migrate",
    "sync:registration": "node scripts/sync-registration.mjs",
    "dev:api": "pnpm --filter @moltforest/api dev",
    "dev:workers": "pnpm --filter @moltforest/workers dev",
    "start:api": "pnpm --filter @moltforest/api start",
    "start:workers": "pnpm --filter @moltforest/workers start",
    "start:indexer": "pnpm --dir apps/indexer start",
    "pm2:api": "pm2 start \"pnpm start:api\" --name moltforest-api",
    "pm2:workers": "pm2 start \"pnpm start:workers\" --name moltforest-workers",
    "pm2:indexer": "pm2 start \"pnpm start:indexer\" --name moltforest-indexer",
    "pm2:all": "pnpm pm2:indexer && pnpm pm2:api && pnpm pm2:workers",
    "scores:publish-epoch": "pnpm --filter @moltforest/scores publish-epoch",
    "scores:prepare-epoch": "pnpm --filter @moltforest/scores prepare-epoch",
    "scores:demo-gate": "pnpm --filter @moltforest/scores demo-score-gate",
    "demo:hire-poc": "pnpm --filter @moltforest/demo-hire-poc demo",
    "deploy:floor3-mainnet": "bash scripts/deploy-floor3-mainnet.sh",
    "record:floor3-mainnet": "node scripts/apply-floor3-addresses.mjs",
    "deploy:receipt-registry": "bash scripts/deploy-receipt-registry.sh",
    "deploy:receipt-registry-mainnet": "NETWORK=mainnet bash scripts/deploy-receipt-registry.sh",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
